NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=xxx
APPWRITE_API_KEY=xxx
APPWRITE_DATABASE_ID=xxx
APPWRITE_TASKS_TABLE_ID=xxx
APPWRITE_SESSION_COOKIE_NAME=taskflow-session
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set this to the deployed API origin when the Electron desktop app uses a separate frontend origin.
NEXT_PUBLIC_API_BASE_URL=
# Comma-separated Electron origins allowed to call the API with credentials.
DESKTOP_ALLOWED_ORIGINS=app://taskflow,http://127.0.0.1:3000,http://localhost:3000
# Optional URL override for the packaged Electron shell. Defaults to the local app://taskflow/ page.
TASKFLOW_WEB_URL=

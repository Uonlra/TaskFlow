{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"]
    },
    "noEmit": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "../src/**/*.ts", "../src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "../node_modules",
    "../**/*.test.ts",
    "../**/*.test.tsx",
    "../**/*.spec.ts",
    "../**/*.spec.tsx",
    "../src/**/__tests__/**"
  ]
}

{
  "name": "taskflow",
  "version": "2.1.1",
  "private": true,
  "description": "TaskFlow personal task workspace",
  "author": "Uonlra",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k \"pnpm dev -- --hostname 127.0.0.1 --port 3000\" \"wait-on http://127.0.0.1:3000 && electron electron/main.cjs\"",
    "desktop:pack": "pnpm desktop:web-build && electron-builder --dir",
    "desktop:dist": "pnpm desktop:web-build && electron-builder --win --x64",
    "desktop:web-build": "node scripts/build-desktop-web.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "prepush:check": "node scripts/pre-push-check.mjs",
    "appwrite:backfill-task-search": "node --env-file=.env.local scripts/backfill-task-search.mjs",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test test/e2e/login.spec.ts test/e2e/auth-guard.spec.ts test/e2e/task-create.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "animejs": "^4.5.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.85.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "top.uta4k.taskflow",
    "productName": "TaskFlow",
    "artifactName": "TaskFlow-Setup-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "electron/**/*",
      "desktop-web/out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist/electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Uonlra",
      "repo": "TaskFlow",
      "releaseType": "draft"
    }
  }
}
